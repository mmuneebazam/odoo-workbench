{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Odoo Workbench",
  "mainBinaryName": "odoo-workbench",
  "version": "0.1.0",
  "identifier": "dev.odoo.workbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Odoo Workbench", "width": 1280, "height": 840, "minWidth": 760, "minHeight": 520 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Development",
    "shortDescription": "Odoo Workbench: an independently rebranded community derivative of Odoo Dev Panel.",
    "longDescription": "Modified by the Odoo Workbench community derivative: product and window names, package identity and desktop branding were changed from upstream Odoo Dev Panel by SparkDrago05, which is distributed under Apache-2.0. Discover, diagnose, run and stop local Odoo development environments. Odoo instances run under their version users through per-user agents and keep running when the app closes.",
    "license": "Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["sudo-rs | sudo", "systemd"],
        "files": {
          "/usr/lib/odoo-dev-panel": "../../packaging/build/odoo-dev-panel",
          "/usr/bin/odp": "../../packaging/build/odoo-dev-panel/bin/odp",
          "/usr/lib/tmpfiles.d/odoo-dev-panel.conf": "../../packaging/tmpfiles.d/odoo-dev-panel.conf"
        },
        "postInstallScript": "../../packaging/deb/postinst",
        "preRemoveScript": "../../packaging/deb/prerm",
        "postRemoveScript": "../../packaging/deb/postrm"
      }
    }
  }
}
